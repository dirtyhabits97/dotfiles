#!/usr/bin/env bash
#
# Switch the terminal colorscheme without editing tracked dotfiles.
#
# Themes live in ~/.config/alacritty/themes/*.toml (tracked). The *choice* lives
# in ~/.local/state/ (untracked), so experimenting never dirties the repo:
#
#   ~/.local/state/theme.toml       copy of the chosen theme; alacritty imports
#                                   it and live-reloads when it changes
#   ~/.local/state/theme            the plain name; read by nvim at startup
#   ~/.local/state/theme.gitconfig  delta's syntax-theme; included by ~/.gitconfig
#
#   theme                       list themes, * marks the current one
#   theme catppuccin-mocha      switch
set -euo pipefail

themes_dir="$HOME/.config/alacritty/themes"
state_dir="$HOME/.local/state"
current=$(cat "$state_dir/theme" 2>/dev/null || true)

# '#rrggbb' -> the SGR escape that paints it. $1 is 38 (fg) or 48 (bg); the
# result lands in $_sgr because $(...) would fork once per color.
sgr() {
  local h=${2#\#}
  printf -v _sgr '\e[%s;2;%d;%d;%dm' "$1" "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

if [[ $# -eq 0 ]]; then
  # Plain list when piped, so `theme | grep` stays scriptable.
  if [[ ! -t 1 || -n ${NO_COLOR:-} ]]; then
    for f in "$themes_dir"/*.toml; do
      name=${f##*/}; name=${name%.toml}
      [[ $name == "$current" ]] && printf '* %s\n' "$name" || printf '  %s\n' "$name"
    done
    exit 0
  fi

  # family:glob, in display order. The globs can't be derived from the names:
  # the nightfox family shares a suffix, and the base variants (rose-pine,
  # tokyo-night) have none. Themes matching nothing print last, ungrouped.
  groups='catppuccin:catppuccin-* kanagawa:kanagawa-* nightfox:*fox rose-pine:rose-pine* tokyo-night:tokyo-night*'

  names=() rows=() taken=()
  for f in "$themes_dir"/*.toml; do
    name=${f##*/}; name=${name%.toml}   # ponytail: basename forks, this doesn't
    [[ $name == "$current" ]] && marker='*' || marker=' '

    # Section-aware: 'black'/'blue' also live under [colors.bright], and
    # 'background' under [colors.footer_bar], [colors.selection], ...
    section= bg= fg= swatch=
    while IFS= read -r line; do
      case $line in
        \#*) continue ;;
        \[*) section=${line#[}; section=${section%%]*} ;;
        *=*)
          key=${line%%=*};  key=${key// /}
          val=${line#*=};   val=${val//[\'\" ]/}
          case $section.$key in
            colors.primary.background) bg=$val ;;
            colors.primary.foreground) fg=$val ;;
            colors.normal.*) sgr 48 "$val"; swatch+="$_sgr  " ;;  # file order = ANSI order
          esac ;;
      esac
    done < "$f"

    sgr 48 "$bg"; pill=$_sgr
    sgr 38 "$fg"; pill+=$_sgr
    printf -v row '%s %s %-20s \e[0m %s\e[0m' "$marker" "$pill" "$name" "$swatch"
    names+=("$name"); rows+=("$row")
  done

  for g in $groups; do
    fam=${g%%:*} pat=${g#*:} shown=
    for i in "${!names[@]}"; do
      [[ -z ${taken[i]:-} && ${names[i]} == $pat ]] || continue
      [[ -n $shown ]] || { printf '\e[1m%s\e[0m\n' "$fam"; shown=1; }
      taken[i]=1
      printf '  %s\n' "${rows[i]}"
    done
  done
  loose=
  for i in "${!names[@]}"; do   # whatever isn't part of a family
    [[ -z ${taken[i]:-} ]] || continue
    [[ -n $loose ]] || { printf '\e[1mothers\e[0m\n'; loose=1; }
    printf '  %s\n' "${rows[i]}"
  done
  exit 0
fi

target="$themes_dir/$1.toml"
[[ -f $target ]] || { echo "no such theme: $1 (run 'theme' to list)" >&2; exit 1; }

mkdir -p "$state_dir"
# ponytail: copy, not symlink — alacritty's file watcher reacts to content changes
cp "$target" "$state_dir/theme.toml"
printf '%s\n' "$1" > "$state_dir/theme"

# delta's syntax theme, for the ~/.gitconfig include. Names come from
# `delta --list-syntax-themes`. Anything unlisted falls back to the terminal's
# own ANSI colors, so a new theme file needs no entry here.
case "$1" in
  catppuccin-latte)     delta_theme="Catppuccin Latte" ;;
  catppuccin-frappe)    delta_theme="Catppuccin Frappe" ;;
  catppuccin-macchiato) delta_theme="Catppuccin Macchiato" ;;
  catppuccin-mocha)     delta_theme="Catppuccin Mocha" ;;
  onehalf-dark)         delta_theme="OneHalfDark" ;;
  *)                    delta_theme="ansi" ;;
esac
printf '[delta]\n\tsyntax-theme = %s\n' "$delta_theme" > "$state_dir/theme.gitconfig"

echo "theme -> $1 (alacritty + delta reload now; restart nvim to pick it up)"
